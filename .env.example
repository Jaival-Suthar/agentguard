# AgentGuard -> TrueForge SDK connection
TRUEFORGE_BASE_URL=http://localhost:8791

# Configure this to the exact model name you enable inside TrueForge.
# Example only — replace after configuring your provider in the UI.
TRUEFORGE_MODEL_NAME=

# Optional defaults for the runtime proof.
TRUEFORGE_AGENT_INSTRUCTIONS=You are a concise incident investigation assistant. Explain your reasoning clearly and use connected tools when available.
TRUEFORGE_PROMPT=In two sentences, introduce yourself and describe what you can do.

# Local TrueForge sandbox provider setup (do not commit a real key).
# Required only for `npm run trueforge:configure-sandbox`.
DAYTONA_API_KEY=
# Required by the recovery/chaos golden path and optional Docker runner.
TRUEFORGE_AGENT_NAME=
TRUEFORGE_INCIDENT_ID=INC-042
TRUEFORGE_MCP_SERVER_NAME=incident.lookup.chaos
