{
  "name": "agentguard",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime assurance for autonomous agents.",
  "type": "module",
  "scripts": {
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "trueforge:health": "tsx src/trueforge/health.ts",
    "trueforge:probe": "tsx src/trueforge/probe.ts",
    "verify:real-mcp": "tsx scripts/verify-real-mcp.ts",
    "verify:chaos-mcp": "tsx scripts/verify-chaos-mcp.ts",
    "investigate:incident": "tsx src/investigator/investigate.ts",
    "trueforge:configure-sandbox": "tsx scripts/configure-trueforge-sandbox.ts",
    "investigate:incident:sandbox": "tsx src/investigator/investigate.ts --sandbox",
    "verify:evidence": "tsx scripts/verify-evidence.ts",
    "verify:policy": "tsx scripts/verify-policy.ts"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "dotenv": "^17.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
